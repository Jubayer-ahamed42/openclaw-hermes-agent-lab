{
  // ===========================================================================
  // OpenClaw Gateway & Nous Hermes Brain Configuration
  // Strict Isolation: Confined to local project environment
  // ===========================================================================

  "gateway": {
    "mode": "local",
    "auth": {
      "token": "openclaw-local-token"
    }
  },

  "memory": {
    "search": {
      "enabled": false
    }
  },

  "agents": {
    "defaults": {
      "workspace": "/root/.openclaw/workspace",
      "model": {
        "primary": "omniroute/auto"
      }
    }
  },

  "models": {
    "providers": {
      // OmniRoute Local AI Gateway (Default Universal Brain)
      "omniroute": {
        "baseUrl": "http://127.0.0.1:20128/v1",
        "apiKey": "${OMNIROUTE_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "auto",
            "name": "OmniRoute Universal Auto Router"
          },
          {
            "id": "gemini-2.0-flash",
            "name": "Google Gemini 2.0 Flash"
          },
          {
            "id": "gemini-2.0-pro",
            "name": "Google Gemini 2.0 Pro"
          }
        ]
      }
    }
  },

  "tools": {
    // Terminal execution capability (Python, PowerShell, Bash)
    "exec": {
      "host": "gateway",
      "mode": "full"
    }
  },

  "channels": {
    // Telegram Bot Gateway
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "open",
      "allowFrom": ["*"]
    }
  }
}
