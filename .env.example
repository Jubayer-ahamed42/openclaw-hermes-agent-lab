# ==============================================================================
# OpenClaw + Nous Hermes Configuration Environment
# ==============================================================================

# --- OmniRoute Configuration (Universal Brain Gateway) ---
# Running locally via Docker on port 20128
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=omniroute-local

# --- Local LLM / OpenAI-Compatible Endpoint (Optional) ---
# If using LM Studio, vLLM, or Ollama OpenAI-compatible gateway:
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_API_KEY=not-needed

# --- Telegram Messaging Channel (Optional) ---
# To enable Telegram bot, create a bot via @BotFather and paste the token here:
TELEGRAM_BOT_TOKEN=
TELEGRAM_DM_POLICY=pairing

# --- Isolation Paths (Pre-configured) ---
OPENCLAW_HOME=./.openclaw
OPENCLAW_CONFIG_PATH=./config/openclaw.json5
OPENCLAW_STATE_DIR=./.openclaw/state
